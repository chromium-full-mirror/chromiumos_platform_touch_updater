mmap: arg2 in ~PROT_EXEC || arg2 in ~PROT_WRITE
openat: 1
newfstatat: 1
mprotect: arg2 in ~PROT_EXEC || arg2 in ~PROT_WRITE
munmap: 1
close: 1
ioctl: arg1 == 0xc00c4806 || arg1 == 0xc0414807
brk: 1
fstatfs: 1
read: 1
execve: 1
faccessat: 1
set_tid_address: 1
set_robust_list: 1
rseq: 1
prlimit64: 1
getrandom: 1
write: 1
exit_group: 1
restart_syscall: 1
exit: 1
rt_sigreturn: 1
