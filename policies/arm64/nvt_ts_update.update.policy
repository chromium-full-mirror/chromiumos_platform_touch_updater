# rseq should be first due to frequency and purpose to decrease nptl latency
rseq: 1

# ioctl: arg1 == HIDIOCSFEATURE(64) || arg1 == HIDIOCGFEATURE(64)
#     || arg1 == TCGETS
ioctl: arg1 == 0xc0404806 || arg1 == 0xc0404807 || arg1 == 0x5401
clock_nanosleep: 1
write: 1
brk: 1
openat: 1
lseek: 1
# Needed since executable is built with --static flag.
execve: 1
set_tid_address: 1
set_robust_list: 1
uname: 1
prlimit64: 1
readlinkat: 1
getrandom: arg2 in ~GRND_RANDOM
mprotect: arg2 in ~PROT_EXEC || arg2 in ~PROT_WRITE
read: 1
newfstatat: 1
close: 1
exit_group: 1
restart_syscall: 1
exit: 1
rt_sigreturn: 1
dup: 1
fcntl: 1
