# rseq should be first due to frequency and purpose to decrease nptl latency
rseq: 1

# Dangerous syscalls.
# ioctl:
#   HIDIOCGFEATURE(531): 0xFFFFFFFFC2134807
#   HIDIOCSFEATURE(8):   0xFFFFFFFFC0084806
#   HIDIOCSFEATURE(531:  0xFFFFFFFFC2134806
# ioctl: arg1 == HIDIOCGFEATURE(531 ||
#   arg1 == HIDIOCSFEATURE(8 || arg1 == HIDIOCSFEATURE(531
ioctl: arg1 == 0xFFFFFFFFC2134807 || arg1 == 0xFFFFFFFFC0084806 || \
  arg1 == 0xFFFFFFFFC2134806

# Safe dangerous syscalls.
mmap: arg2 in ~PROT_EXEC || arg2 in ~PROT_WRITE
mprotect: arg2 in ~PROT_EXEC || arg2 in ~PROT_WRITE
getrandom: arg2 in ~GRND_RANDOM

clock_nanosleep: 1
read: 1
write: 1
openat: 1
newfstatat: 1
fstat: 1
close: 1
brk: 1
fstatfs: 1
gettid: 1
fchmodat: 1
faccessat: 1
set_tid_address: 1
set_robust_list: 1
prlimit64: 1
munmap: 1
lseek: 1
exit_group: 1
restart_syscall: 1
exit: 1
rt_sigreturn: 1
