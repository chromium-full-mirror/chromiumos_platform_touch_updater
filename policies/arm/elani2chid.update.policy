# These seccomp rules specify only the syscalls used by elan_i2chid_iap
# tool when updating the firmware.
# rseq should be first due to frequency and purpose to decrease nptl latency
rseq: 1

# IOCTL Information:
#  elani2chid_tools:
#   HIDIOCGRAWINFO: 0x80084803
#  termios
#   TCGETS: 0x00005401
# syscall Information from jouralctrl:
#  elani2chid_tools:
#   mprotect: 125
#   openat: 257
#   ARM_set_tls: 983045

execve: 1
nanosleep: 1
clock_nanosleep: 1
clock_nanosleep_time64: 1
restart_syscall: 1
rt_sigreturn: 1
exit: 1
exit_group: 1
_newselect: 1
brk: 1
fcntl64: 1
open: 1
close: 1
read: 1
write: 1
ioctl: arg1 == 0x80084803 || arg1 == 0x00005401
stat64: 1
fstat64: 1
fstatat64: 1
getrandom: 1
statx: 1
lseek: 1
_llseek: 1
access: 1
uname: 1
getdents: 1
getdents64: 1
readlink: 1
gettimeofday: 1
openat: 1
mmap2: arg2 in ~PROT_EXEC || arg2 in ~PROT_WRITE
mseal: 1
mprotect: arg2 in ~PROT_EXEC || arg2 in ~PROT_WRITE
munmap: 1
ARM_set_tls: 1
clock_gettime: 1
clock_gettime64: 1
fstatfs: 1
fstatfs64: 1
pselect6: 1
pselect6_time64: 1
set_tid_address: 1
set_robust_list: 1
prlimit64: 1
gettid: 1
ugetrlimit: 1
