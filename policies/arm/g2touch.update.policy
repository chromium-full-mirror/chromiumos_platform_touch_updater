# Policy file for g2touch touchscreen tools.
# It is used to update touchscreen firmware.

write: 1
read: 1
_newselect: 1
fstat64: 1
nanosleep: 1
clock_nanosleep: 1
clock_nanosleep_time64: 1
brk: 1
#arg1 == TCGETS : 0x5401
ioctl: arg1 == 0x5401
close: 1
openat: 1
_llseek: 1
rt_sigaction: 1
rt_sigprocmask: 1
ugetrlimit: 1
mmap2: arg2 in ~PROT_EXEC || arg2 in ~PROT_WRITE
munmap: 1
exit_group: 1
restart_syscall: 1
exit: 1
rt_sigreturn: 1
