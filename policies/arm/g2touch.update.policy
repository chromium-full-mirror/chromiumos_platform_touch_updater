# Policy file for g2touch touchscreen tools.
# It is used to update touchscreen firmware.

# rseq should be first due to frequency and purpose to decrease nptl latency
rseq: 1

write: 1
read: 1
_newselect: 1
fstat64: 1
fstatat64: 1
getrandom: 1
statx: 1
nanosleep: 1
clock_nanosleep: 1
clock_nanosleep_time64: 1
brk: 1
#arg1 == TCGETS : 0x5401
ioctl: arg1 == 0x5401
close: 1
openat: 1
_llseek: 1
rt_sigaction: 1
rt_sigprocmask: 1
ugetrlimit: 1
mmap2: arg2 in ~PROT_EXEC || arg2 in ~PROT_WRITE
mseal: 1
munmap: 1
exit_group: 1
restart_syscall: 1
exit: 1
rt_sigreturn: 1
fstatfs: 1
fstatfs64: 1
pselect6: 1
set_tid_address: 1
uname: 1
set_robust_list: 1
gettid: 1
