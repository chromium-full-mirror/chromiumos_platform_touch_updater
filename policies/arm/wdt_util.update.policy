# rseq should be first due to frequency and purpose to decrease nptl latency
rseq: 1
nanosleep: 1
clock_nanosleep: 1
clock_nanosleep_time64: 1
# ioctl:
#   I2C_FUNCS: 0x705
#   I2C_RDWR: 0x707
ioctl: arg1 == 0x705 || arg1 == 0x707
clock_gettime: 1
clock_gettime64: 1
write: 1
read: 1
openat: 1
fstat64: 1
fstatat64: 1
getrandom: arg2 in ~GRND_RANDOM
statx: 1
getdents64: 1
_llseek: 1
close: 1
getuid32: 1
geteuid32: 1
exit_group: 1
restart_syscall: 1
exit: 1
rt_sigreturn: 1
fstatfs: 1
fstatfs64: 1
set_tid_address: 1
uname: 1
munmap: 1
set_robust_list: 1
gettid: 1
writev: 1