# These seccomp rules specify only the syscalls used by gdixfwupdate
# when updating firmware on the device.

# rseq should be first due to frequency and purpose to decrease nptl latency
rseq: 1

openat: 1
ioctl: 1
nanosleep: 1
clock_nanosleep: 1
clock_nanosleep_time64: 1
brk: 1
open: 1
lseek: 1
_llseek: 1
access: 1
restart_syscall: 1
ARM_set_tls: 1
rt_sigreturn: 1
readlink: 1
mmap2: arg2 in ~PROT_EXEC || arg2 in ~PROT_WRITE
mseal: 1
munmap: 1
uname: 1
close: 1
exit: 1
exit_group: 1
read: 1
write: 1
fstatfs: 1
fstatfs64: 1
getrandom: 1
set_tid_address: 1
set_robust_list: 1
gettid: 1
