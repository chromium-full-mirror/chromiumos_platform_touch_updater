# rseq should be first due to frequency and purpose to decrease nptl latency
rseq: 1

# ioctl: arg1 == HIDIOCSFEATURE(64) || arg1 == HIDIOCGFEATURE(64)
ioctl: arg1 == 0xc0404806 || arg1 == 0xc0404807
brk: 1
clock_nanosleep: 1
clock_nanosleep_time64: 1
execve: 1
ARM_set_tls: 1
uname: 1
readlink: 1
mprotect: arg2 in ~PROT_EXEC || arg2 in ~PROT_WRITE
openat: 1
statx: 1
fstat64: 1
getrandom: 1
write: 1
exit_group: 1
restart_syscall: 1
exit: 1
rt_sigreturn: 1
set_tid_address: 1
munmap: 1
set_robust_list: 1
ugetrlimit: 1
gettid: 1
