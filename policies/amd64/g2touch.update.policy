# Policy file for g2touch touchscreen tools.
# It is used to update touchscreen firmware.

# rseq should be first due to frequency and purpose to decrease nptl latency
rseq: 1

gettid: 1
write: 1
ioctl: 1
read: 1
select: 1
pselect6: 1
gettimeofday: 1
stat: 1
fstat: 1
newfstatat: 1
getrandom: 1
brk: 1
close: 1
open: 1
openat: 1
lseek: 1
nanosleep: 1
clock_nanosleep: 1
uname: 1
arch_prctl: 1
readlink: 1
access: 1
mmap: arg2 in ~PROT_EXEC || arg2 in ~PROT_WRITE
mseal: 1
munmap: 1
exit_group: 1
restart_syscall: 1
exit: 1
rt_sigreturn: 1
fstatfs: 1
set_tid_address: 1
set_robust_list: 1
