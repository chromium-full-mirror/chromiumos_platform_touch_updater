# These seccomp rules specify only the syscalls used by the ftphid_ezupg_ap
# tool.  The updater ftphid_ezupg_ap should only be used through minijail with
# these rules.

# rseq should be first due to frequency and purpose to decrease nptl latency
rseq: 1
arch_prctl: 1
# ftphid_ezupg_ap : it's necessary for basic comminication
execve: 1
# ftphid_ezupg_ap : it's necessary for basic comminication
clone: 1
pipe2: 1
wait4: 1
restart_syscall: 1
rt_sigreturn: 1
exit: 1
exit_group: 1
select: 1
pselect6: 1
brk: 1
fcntl: 1
open: 1
close: 1
read: 1
write: 1
# IOCTL Information:
#  ftphid_ezupg_ap:
#   HIDIOSCFEATURE: 0xc0404806
#   HIDIOGCFEATURE: 0xc0404807
#   HIDIOCGRAWINFO: 0x80084803
ioctl: arg1 == 0xc0404806 || arg1 == 0xc0404807 || arg1 == 0x80084803
stat: 1
fstat: 1
newfstatat: 1
lseek: 1
readlink: 1
unlink: 1
access: 1
uname: 1
getdents: 1
getdents64: 1
time: 1
gettimeofday: 1
openat: 1
dup2: 1
mmap: arg2 in ~PROT_EXEC || arg2 in ~PROT_WRITE
mseal: 1
mprotect: arg2 in ~PROT_EXEC || arg2 in ~PROT_WRITE
rt_sigaction: 1
nanosleep: 1
clock_nanosleep: 1
set_robust_list: 1
munmap: 1
rt_sigprocmask: 1
prlimit64: 1
set_tid_address: 1
getpid: 1
geteuid: 1
getppid: 1
futex: 1
fstatfs: 1
pread64: 1
timerfd_settime: 1
poll: 1
mremap: 1
faccessat: 1
faccessat2: 1
timerfd_create: 1
pipe: 1
recvmsg: 1
sendmsg: 1
sendto: 1
gettid: 1
madvise: 1
dup: 1
dup3: 1
sched_get_priority_max: 1
sched_getattr: 1
sched_setattr: 1
getsockname: 1
clock_getres: 1
clock_gettime: 1
sched_get_priority_min: 1
setsockopt: 1
bind: 1
sched_getparam: 1
setsid: 1
getrlimit: 1
sched_getscheduler: 1
chdir: 1
getuid: 1
getgid: 1
getegid: 1
tgkill: 1
getresgid: 1
getresuid: 1
signalfd4: 1
setpriority: 1
epoll_create1: 1
epoll_ctl: 1
epoll_wait: 1
readlinkat: 1
lstat: 1
getrandom: arg2 in ~GRND_RANDOM
prctl: 1