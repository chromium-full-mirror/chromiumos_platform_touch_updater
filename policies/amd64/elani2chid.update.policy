# These seccomp rules specify only the syscalls used by elan_i2chid_iap
# tool when updating the firmware.
# IOCTL Information:
#  elani2chid_tools:
#   HIDIOCGRAWINFO: 0x80084803
#  termios
#   TCGETS: 0x00005401
# syscall Information from jouralctrl:
#  dup2: 33
#  openat: 257

arch_prctl: 1
execve: 1
nanosleep: 1
restart_syscall: 1
rt_sigreturn: 1
exit: 1
exit_group: 1
select: 1
brk: 1
open: 1
close: 1
read: 1
write: 1
ioctl: arg1 == 0x80084803 || arg1 == 0x00005401
stat: 1
fstat: 1
lseek: 1
access: 1
uname: 1
getdents: 1
readlink: 1
unlink: 1
time: 1
gettimeofday: 1
openat: 1
dup2: 1