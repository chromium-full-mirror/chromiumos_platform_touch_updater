# found in the LICENSE file.
# These seccomp rules specify only the syscalls used by the Zinitix FW update
# tool.  The updater Zinitix_FWupdate should only be used through minijail with
# these rules.

# rseq should be first due to frequency and purpose to decrease nptl latency
rseq: 1

brk: 1
# HIDIOCGFEATURE(8): 0xc0084807
# HIDIOCSFEATURE(18): 0xc0124806
# TCGETS : 0x00005401
ioctl: arg1 == 0xc0084807 || arg1 == 0xc0124806 || arg1 == 0x00005401
fstat: 1
newfstatat: 1
getrandom: arg2 in ~GRND_RANDOM
execve: 1
arch_prctl: 1
uname: 1
readlink: 1
openat: 1
write: 1
close: 1
exit_group: 1
lseek: 1
read: 1
restart_syscall: 1
exit: 1
rt_sigreturn: 1
fstatfs: 1
set_tid_address: 1
munmap: 1
set_robust_list: 1
gettid: 1
readlinkat: 1
clone: 1
clone3: 1
prlimit64: 1
prctl: arg0 == PR_SET_KEEPCAPS || arg0 == PR_SET_NAME
rt_sigaction: 1
mprotect: arg2 in ~PROT_EXEC || arg2 in ~PROT_WRITE
wait4: 1
dup : 1
fcntl : 1
